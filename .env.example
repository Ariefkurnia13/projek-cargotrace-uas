APP_NAME=CargoTrace
APP_ENV=local
APP_KEY=base64:q2e6+Fh4a+zUv8wE4z4eZ/3sO4Fv6Zk0x2F+mB9G1U8=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL 8+ by default, or change to sqlite for quick testing)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cargotrace_db
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cargotrace.test"
MAIL_FROM_NAME="${APP_NAME}"

# CargoTrace Specific Business Configuration
# Group scenario: Group A (12h threshold), Group B (18h threshold), Group C (24h threshold)
CARGOTRACE_SCENARIO_GROUP=Group A
CARGOTRACE_DELAY_THRESHOLD_HOURS=12

# External API Configuration
# Uses free Open-Meteo API / Nominatim Geocoding with fallback simulation & timeout handling
WEATHER_API_ENABLED=true
WEATHER_API_TIMEOUT=3
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_ENABLED=true
GEOCODING_API_TIMEOUT=3
GEOCODING_API_BASE_URL=https://nominatim.openstreetmap.org/search
